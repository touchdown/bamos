{
  "$schema": "https://opencode.ai/config.schema.json",
  "provider": {
{%- if llm_runtime in ['ollama', 'all'] %}
    "ollama": {
      "options": {
        "baseURL": "{{ llm_ollama_host }}/v1"
      },
      "models": {
        "{{ llm_opencode_default_model }}": {
          "name": "{{ llm_opencode_default_model }}"
        }
      }
    }{{ ',' if llm_runtime in ['basert', 'all'] else '' }}
{%- endif %}
{%- if llm_runtime in ['basert', 'all'] %}
    "basert": {
      "name": "BaseRT",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{ llm_basert_host }}/v1",
        "apiKey": "basert"
      },
      "models": {
        "{{ llm_basert_default_model }}": {
          "name": "{{ llm_basert_default_model }}",
          "limit": {
            "context": {{ llm_basert_max_context }},
            "output": {{ llm_basert_max_output }}
          }
        }
      }
    }
{%- endif %}
  },
  "model": "{% if llm_runtime in ['ollama', 'all'] %}ollama/{{ llm_opencode_default_model }}{% else %}basert/{{ llm_basert_default_model }}{% endif %}"
}
